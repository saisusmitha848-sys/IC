// All products
SELECT * FROM products;

// Product names and prices
SELECT product_name, price FROM products;

// Unique categories
SELECT DISTINCT category FROM products;

// Products costing more than 5000
SELECT * FROM products WHERE price > 5000;

// Products costing less than 2000
SELECT * FROM products WHERE price < 2000;

// Electronics products
SELECT * FROM products WHERE category = 'Electronics';

// Products with stock below 10
SELECT * FROM products WHERE stock_quantity < 10;

// Electronics products costing more than 10000
SELECT * FROM products
WHERE category = 'Electronics' AND price > 10000;

// Electronics or Furniture products
SELECT * FROM products
WHERE category = 'Electronics' OR category = 'Furniture';

// Products not in Clothing
SELECT * FROM products
WHERE NOT category = 'Clothing';




// Product names starting with S
SELECT * FROM products WHERE product_name LIKE 'S%';

// Product names ending with e
SELECT * FROM products WHERE product_name LIKE '%e';

// Product names containing Phone
SELECT * FROM products WHERE product_name LIKE '%Phone%';

// Customer names starting with A
SELECT * FROM customers WHERE customer_name LIKE 'A%';

// Customers from Bangalore, Chennai, or Mysore
SELECT * FROM customers
WHERE city IN ('Bangalore', 'Chennai', 'Mysore');

// Products priced between 1000 and 10000
SELECT * FROM products
WHERE price BETWEEN 1000 AND 10000;

// Customers aged between 20 and 30
SELECT * FROM customers
WHERE age BETWEEN 20 AND 30;

// Suppliers whose names contain Tech
SELECT * FROM products
WHERE supplier LIKE '%Tech%';



// Products by price ascending
SELECT * FROM products ORDER BY price ASC;

// Products by price descending
SELECT * FROM products ORDER BY price DESC;

// Five most expensive products
SELECT * FROM products ORDER BY price DESC LIMIT 5;

// Five cheapest products
SELECT * FROM products ORDER BY price ASC LIMIT 5;

// Customers alphabetically
SELECT * FROM customers ORDER BY customer_name ASC;

// Latest ten sales transactions
SELECT * FROM sales ORDER BY sale_date DESC, sale_id DESC LIMIT 10;

// Products sorted by stock quantity
SELECT * FROM products ORDER BY stock_quantity ASC;





// Update the price of a particular product
UPDATE products
SET price = 27000
WHERE product_id = 1;

// Increase all Electronics prices by 10%
UPDATE products
SET price = price * 1.10
WHERE category = 'Electronics';

// Update stock quantity
UPDATE products
SET stock_quantity = 25
WHERE product_id = 3;

// Change a customer's city
UPDATE customers
SET city = 'Chennai'
WHERE customer_id = 1;

// Update a customer's email
UPDATE customers
SET email = 'ananya.new@gmail.com'
WHERE customer_id = 1;

// Change payment mode of a sale
UPDATE sales
SET payment_mode = 'UPI'
WHERE sale_id = 1;



SELECT * FROM sales WHERE product_id = 15;

// Delete only if the SELECT above returns no rows
DELETE FROM products
WHERE product_id = 15;



SELECT * FROM sales WHERE customer_id = 15;

// Delete their sales first, if you intend to remove those transactions
DELETE FROM sales WHERE customer_id = 15;

// Then delete the customer
DELETE FROM customers WHERE customer_id = 15;




DELETE FROM sales
WHERE sale_date < '2025-02-01';



// Add discount percentage
ALTER TABLE products
ADD discount_percentage DECIMAL(5,2) DEFAULT 0;

// Add customer mobile number
ALTER TABLE customers
ADD mobile_number VARCHAR(15);

// Modify supplier datatype
ALTER TABLE products
MODIFY supplier VARCHAR(150);

// Rename created_date
ALTER TABLE products
RENAME COLUMN created_date TO product_added_date;

// Add product status with default value
ALTER TABLE products
ADD product_status VARCHAR(20) DEFAULT 'Available';

// Drop an unnecessary column
ALTER TABLE customers
DROP COLUMN mobile_number;

// Display modified structures
DESCRIBE products;
DESCRIBE customers;
DESCRIBE sales;



// Total number of products
SELECT COUNT(*) AS total_products FROM products;

// Total number of customers
SELECT COUNT(*) AS total_customers FROM customers;

// Total number of sales
SELECT COUNT(*) AS total_sales FROM sales;

// Total revenue
SELECT SUM(total_amount) AS total_revenue FROM sales;

// Average product price
SELECT AVG(price) AS average_product_price FROM products;

// Most expensive product
SELECT product_name, price
FROM products
ORDER BY price DESC
LIMIT 1;

// Cheapest product
SELECT product_name, price
FROM products
ORDER BY price ASC
LIMIT 1;

// Highest sales transaction amount
SELECT MAX(total_amount) AS highest_transaction
FROM sales;

// Total quantity of products sold
SELECT SUM(quantity) AS total_quantity_sold
FROM sales;

// Average sales transaction value
SELECT AVG(total_amount) AS average_transaction_value
FROM sales;





// Count products in each category
SELECT category, COUNT(*) AS product_count
FROM products
GROUP BY category;

// Average product price category-wise
SELECT category, AVG(price) AS average_price
FROM products
GROUP BY category;

// Total stock quantity category-wise
SELECT category, SUM(stock_quantity) AS total_stock
FROM products
GROUP BY category;

// Total revenue category-wise
SELECT p.category, SUM(s.total_amount) AS total_revenue
FROM products p
INNER JOIN sales s ON p.product_id = s.product_id
GROUP BY p.category;

// Number of sales transactions for each payment mode
SELECT payment_mode, COUNT(*) AS transaction_count
FROM sales
GROUP BY payment_mode;

// Total sales quantity for each product
SELECT p.product_name, SUM(s.quantity) AS total_quantity_sold
FROM products p
INNER JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name;

// Categories having more than three products
SELECT category, COUNT(*) AS product_count
FROM products
GROUP BY category
HAVING COUNT(*) > 3;

// Products whose total sold quantity is greater than 5
SELECT p.product_name, SUM(s.quantity) AS total_quantity_sold
FROM products p
INNER JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name
HAVING SUM(s.quantity) > 5;

// Payment modes with more than five transactions
SELECT payment_mode, COUNT(*) AS transaction_count
FROM sales
GROUP BY payment_mode
HAVING COUNT(*) > 5;







// Product Inventory Report
SELECT product_id, product_name, category, stock_quantity
FROM products;

// Low Stock Report
SELECT * FROM products
WHERE stock_quantity < 10;

// Category Report
SELECT category, COUNT(*) AS product_count
FROM products
GROUP BY category;

// Product Price Report: highest and lowest
SELECT product_name, price
FROM products
WHERE price = (SELECT MAX(price) FROM products)
   OR price = (SELECT MIN(price) FROM products);

// Customer Report
SELECT * FROM customers;

// Sales Report
SELECT s.sale_id, c.customer_name, p.product_name,
       s.quantity, s.total_amount, s.payment_mode, s.sale_date
FROM sales s
JOIN customers c ON s.customer_id = c.customer_id
JOIN products p ON s.product_id = p.product_id;

// Revenue Report
SELECT SUM(total_amount) AS total_revenue
FROM sales;

// Payment-mode-wise sales
SELECT payment_mode, SUM(total_amount) AS revenue
FROM sales
GROUP BY payment_mode;

// Best-Selling Products
SELECT p.product_name, SUM(s.quantity) AS total_quantity_sold
FROM products p
JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_quantity_sold DESC;

// Customer-wise purchase totals
SELECT c.customer_name, COALESCE(SUM(s.total_amount), 0) AS purchase_total
FROM customers c
LEFT JOIN sales s ON c.customer_id = s.customer_id
GROUP BY c.customer_id, c.customer_name;




// Product that generated the highest total revenue
SELECT p.product_name, SUM(s.total_amount) AS total_revenue
FROM products p
JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_revenue DESC
LIMIT 1;

// Customer who made the highest-value purchase (single transaction)
SELECT c.customer_name, s.sale_id, s.total_amount
FROM customers c
JOIN sales s ON c.customer_id = s.customer_id
ORDER BY s.total_amount DESC
LIMIT 1;

// Products that have never been sold
SELECT p.product_id, p.product_name
FROM products p
LEFT JOIN sales s ON p.product_id = s.product_id
WHERE s.product_id IS NULL;

// Customers who have never made a purchase
SELECT c.customer_id, c.customer_name
FROM customers c
LEFT JOIN sales s ON c.customer_id = s.customer_id
WHERE s.customer_id IS NULL;

// Category that generated the highest revenue
SELECT p.category, SUM(s.total_amount) AS total_revenue
FROM products p
JOIN sales s ON p.product_id = s.product_id
GROUP BY p.category
ORDER BY total_revenue DESC
LIMIT 1;

// Products with stock quantity below 5
SELECT * FROM products
WHERE stock_quantity < 5;

// Total revenue through each payment mode
SELECT payment_mode, SUM(total_amount) AS total_revenue
FROM sales
GROUP BY payment_mode;

//.SELECT p.product_name, SUM(s.quantity) AS total_quantity_sold
FROM products p
JOIN sales s ON p.product_id = s.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_quantity_sold DESC
LIMIT 5;

// Customers who purchased more than one type of product
SELECT c.customer_name, COUNT(DISTINCT s.product_id) AS product_types
FROM customers c
JOIN sales s ON c.customer_id = s.customer_id
GROUP BY c.customer_id, c.customer_name
HAVING COUNT(DISTINCT s.product_id) > 1;
 Top five products based on total quantity sold

// Monthly sales summary
SELECT YEAR(sale_date) AS sales_year,
       MONTH(sale_date) AS sales_month,
       COUNT(*) AS transaction_count,
       SUM(quantity) AS quantity_sold,
       SUM(total_amount) AS monthly_revenue
FROM sales
GROUP BY YEAR(sale_date), MONTH(sale_date)
ORDER BY sales_year, sales_month;